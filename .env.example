# Copy to .env and fill in from your own AWS account. .env is gitignored.
# Create these with the Cognito setup documented in the README.
AWS_REGION=us-east-1

# Cognito machine-to-machine identity. The agent proves it is the agent;
# there is no user and no password anywhere in this flow.
COGNITO_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_DISCOVERY_URL=https://cognito-idp.us-east-1.amazonaws.com/POOL_ID/.well-known/openid-configuration
COGNITO_TOKEN_URL=https://YOUR-PREFIX.auth.us-east-1.amazoncognito.com/oauth2/token
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_SCOPE=home-operator/tools.invoke

# The deployed MCP server on AgentCore Runtime. The ARN is percent-encoded
# into the path; `agentcore status` prints the ARN.
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT:runtime/NAME-ID
AGENTCORE_MCP_URL=https://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/ENCODED_ARN/invocations?qualifier=DEFAULT
